# Include in your HTTPS server block. Set root to the built frontend/dist directory.
root /srv/eco/frontend/dist;
index index.html;
add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
add_header X-Content-Type-Options nosniff always;

location = /api { proxy_pass http://127.0.0.1:8000; }
location /api/ { proxy_pass http://127.0.0.1:8000; proxy_set_header Host $host; }
location = /admin { proxy_pass http://127.0.0.1:8000; }
location /admin/ { proxy_pass http://127.0.0.1:8000; proxy_set_header Host $host; }
location /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    # Nginx add_header at this scope replaces inherited headers; repeat them.
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
}
location = /index.html { expires -1; }
location / { try_files $uri $uri/ /index.html; }
